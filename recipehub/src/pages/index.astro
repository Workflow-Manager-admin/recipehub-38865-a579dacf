---
import { useState } from 'react';

const PRIMARY_COLOR = "#FF7043";
const SECONDARY_COLOR = "#FFF3E0";
const ACCENT_COLOR = "#388E3C";

const featuredRecipes = [
  {
    title: "Zesty Lemon Chicken",
    image: "/featured1.jpg",
    id: 1,
    categories: ["Dinner", "Healthy"]
  },
  {
    title: "Classic Margherita Pizza",
    image: "/featured2.jpg",
    id: 2,
    categories: ["Italian", "Vegetarian"]
  },
  {
    title: "Blueberry Pancakes",
    image: "/featured3.jpg",
    id: 3,
    categories: ["Breakfast", "Sweet"]
  }
];

const categories = [
  { name: "Breakfast", icon: "🍳", color: ACCENT_COLOR },
  { name: "Lunch", icon: "🥗", color: PRIMARY_COLOR },
  { name: "Dinner", icon: "🍲", color: "#FFA726" },
  { name: "Dessert", icon: "🍰", color: "#8E24AA" },
  { name: "Vegan", icon: "🥦", color: "#43A047" },
  { name: "Quick & Easy", icon: "⚡", color: "#1976D2" }
];

const allRecipes = [
  {
    id: 101,
    title: "Lemon Chicken",
    img: "/chicken.jpg",
    rating: 4.5,
    cookTime: "30 min",
    category: "Dinner"
  },
  {
    id: 102,
    title: "Vegan Buddha Bowl",
    img: "/buddha.jpg",
    rating: 4.7,
    cookTime: "20 min",
    category: "Vegan"
  },
  {
    id: 103,
    title: "Chocolate Lava Cake",
    img: "/lava-cake.jpg",
    rating: 4.9,
    cookTime: "40 min",
    category: "Dessert"
  },
  {
    id: 104,
    title: "Caesar Salad",
    img: "/caesar.jpg",
    rating: 4.3,
    cookTime: "15 min",
    category: "Lunch"
  }
];

const recipeDetails = {
  101: {
    title: "Lemon Chicken",
    img: "/chicken.jpg",
    description: "Zesty chicken with fresh lemon and herbs.",
    ingredients: [
      "2 chicken breasts",
      "1 lemon",
      "1 tbsp olive oil",
      "Salt & pepper to taste",
      "Fresh herbs (thyme, rosemary)"
    ],
    instructions: [
      "Season chicken with salt, pepper, and herbs.",
      "Heat oil in a skillet and cook chicken until golden.",
      "Squeeze lemon over the chicken and serve with extra herbs."
    ],
    comments: [
      { user: "Anna", rating: 5, comment: "So flavorful and easy!" },
      { user: "Liam", rating: 4, comment: "Family loved it!" }
    ]
  },
  // Add more details for each recipe id as needed...
};

// App-wide state: selected tab, selectedRecipeID, searchQuery, favorites, collections (using useState in React - functional demo purpose only, since Astro uses mostly static rendering, should delegate actual state to frontend in real app)
let currentTab = "home";
let searchValue = "";
let selectedRecipe = null;
let detailTab = "Ingredients";
let favorites = [];
let collections = ["Family Dinners", "Quick Lunches"];

function handleTab(tab) {
  currentTab = tab;
  selectedRecipe = null;
  detailTab = "Ingredients";
  searchValue = "";
}
function selectRecipe(id) {
  selectedRecipe = id;
  detailTab = "Ingredients";
}
function handleFavorite(id) {
  if (!favorites.includes(id)) {
    favorites.push(id);
  } else {
    favorites = favorites.filter(f => f !== id);
  }
}
function addToCollection(colName, id) {
  // Pseudocode for demo purposes; would create and manage collections in a real app.
  // For now, just alert.
  alert(`Added Recipe ${id} to ${colName}`);
}
function handleDetailTab(tab) {
  detailTab = tab;
}

// Filter recipes based on search or tab
function getDisplayedRecipes() {
  let recs = allRecipes;
  if (currentTab === "favorites") {
    recs = allRecipes.filter(r => favorites.includes(r.id));
  } else if (currentTab === "collections") {
    // For demo, just using all recipes
    recs = allRecipes;
  }
  if (searchValue) {
    recs = recs.filter(r => r.title.toLowerCase().includes(searchValue.toLowerCase()));
  }
  return recs;
}

// End pseudo-reactive helpers

---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>RecipeHub</title>
    <meta name="viewport" content="width=device-width, initial-scale=1"/>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <style>
      :root {
        --primary: #FF7043;
        --secondary: #FFF3E0;
        --accent: #388E3C;
        --text: #212121;
        --shadow: 0 2px 8px rgba(50,20,0,0.08);
      }
      body {
        margin: 0;
        font-family: 'Segoe UI', Arial, sans-serif;
        background: var(--secondary);
        color: var(--text);
      }
      .container {
        max-width: 470px;
        margin: 0 auto;
        min-height: 100dvh;
        background: #fff;
        box-shadow: 0px 4px 32px rgba(198, 116, 77, 0.05), 0 0px 0 var(--primary);
        border-radius: 0 0 32px 32px;
        overflow: hidden;
        position: relative;
      }

      /* Search Bar */
      .search-bar {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 24px 18px 0 18px;
        background: var(--secondary);
        position: sticky;
        top: 0;
        z-index: 10;
      }
      .search-bar input {
        flex: 1;
        border: none;
        border-radius: 24px;
        background: #fff;
        padding: 13px 18px;
        font-size: 1em;
        box-shadow: var(--shadow);
        outline: none;
      }
      .search-bar button {
        background: var(--primary);
        border: none;
        border-radius: 50%;
        color: #fff;
        width: 38px;
        height: 38px;
        font-size: 1.3em;
        cursor: pointer;
        transition: background 0.2s;
      }
      .search-bar button:hover {
        background: var(--accent);
      }

      /* Carousel */
      .carousel {
        margin: 20px 0 8px 0;
        display: flex;
        overflow-x: auto;
        gap: 18px;
        padding: 0 14px;
        scrollbar-width: thin;
      }
      .carousel-card {
        min-width: 250px;
        background: var(--primary);
        color: #fff;
        border-radius: 22px;
        box-shadow: var(--shadow);
        cursor: pointer;
        transition: transform 0.12s;
        display: flex;
        flex-direction: column;
        align-items: center;
      }
      .carousel-card img {
        border-top-left-radius: 22px;
        border-top-right-radius: 22px;
        width: 100%;
        display: block;
        object-fit: cover;
        max-height: 140px;
      }
      .carousel-card h3 {
        margin: 13px 10px 15px 10px;
        font-size: 1.09em;
        font-weight: 500;
        text-align: center;
      }
      .carousel-card:hover {
        transform: translateY(-5px) scale(1.035);
        background: var(--accent);
      }

      /* Category Cards */
      .categories {
        display: flex;
        gap: 10px;
        overflow-x: auto;
        padding: 8px 14px 17px 14px;
      }
      .category-card {
        flex: 0 0 110px;
        background: #fff;
        border-radius: 18px;
        box-shadow: var(--shadow);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 4px;
        cursor: pointer;
        border: 2px solid var(--secondary);
        transition: border 0.15s, box-shadow 0.13s;
        padding: 9px 0;
      }
      .category-card.active, .category-card:active, .category-card:focus {
        border-color: var(--primary);
        box-shadow: 0 0 0 2px var(--primary) inset;
      }
      .category-icon {
        font-size: 2em;
        background: var(--secondary);
        border-radius: 12px;
        width: 40px;
        height: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 5px;
      }
      .category-name {
        font-size: 0.98em;
        color: #444;
        margin-bottom: 0;
      }

      /* Recipe List */
      .recipes-section {
        padding: 10px 16px 24px 16px;
      }
      .recipes-list {
        display: flex;
        flex-direction: column;
        gap: 17px;
      }
      .recipe-card {
        display: flex;
        align-items: center;
        background: var(--secondary);
        border-radius: 18px;
        box-shadow: 0 1px 6px rgba(160, 160, 130, 0.07);
        padding: 8px 10px;
        cursor: pointer;
        transition: box-shadow 0.17s;
      }
      .recipe-card:hover {
        box-shadow: 0 8px 22px -8px var(--primary);
      }
      .recipe-img {
        width: 72px;
        height: 72px;
        object-fit: cover;
        border-radius: 16px;
        margin-right: 16px;
        background: #fff;
      }
      .recipe-info {
        flex: 1;
        display: flex;
        flex-direction: column;
      }
      .recipe-title {
        font-size: 1.1em;
        font-weight: 600;
        margin-bottom: 7px;
        color: var(--primary);
      }
      .recipe-meta {
        color: #838383;
        font-size: 0.93em;
        display: flex;
        gap: 19px;
      }
      .favorite-btn {
        margin-left: 14px;
        border: none;
        background: transparent;
        color: var(--accent);
        font-size: 1.42em;
        transition: color 0.19s;
        cursor: pointer;
        outline: none;
      }
      .favorite-btn.faved,
      .favorite-btn:hover {
        color: var(--primary);
      }

      /* Detailed Recipe View */
      .detail-modal {
        position: fixed;
        inset: 0;
        background: rgba(40,20,0,0.10);
        z-index: 30;
        display: flex;
        align-items: center;
        justify-content: center;
        animation: fadein 0.21s;
      }
      @keyframes fadein { from {opacity: 0} to {opacity: 1}}
      .detail-content {
        background: #fff;
        border-radius: 28px;
        width: 95vw;
        max-width: 410px;
        box-shadow: 0 8px 28px rgba(80,50,0,0.10);
        padding: 0 0 10px 0;
        position: relative;
        max-height: 90vh;
        overflow: auto;
      }
      .detail-header {
        display: flex;
        align-items: flex-start;
        gap: 16px;
        padding: 20px 18px 9px 18px;
      }
      .detail-header img {
        width: 92px;
        height: 92px;
        border-radius: 16px;
        object-fit: cover;
        background: var(--secondary);
      }
      .detail-header h2 {
        margin: 0 0 10px 0;
        font-size: 1.19em;
      }
      .detail-buttons {
        display: flex;
        gap: 8px;
        margin: 13px 0 0 0;
      }
      .detail-buttons button {
        border: none;
        background: var(--primary);
        color: #fff;
        border-radius: 18px;
        padding: 7px 17px;
        margin-right: 6px;
        font-size: 0.97em;
        cursor: pointer;
        transition: background 0.18s;
      }
      .detail-buttons button:last-child {
        margin-right: 0;
      }
      .close-btn {
        position: absolute;
        top: 18px;
        right: 14px;
        border: none;
        background: #fbe9e7;
        color: var(--primary);
        font-size: 1.34em;
        border-radius: 50%;
        width: 36px;
        height: 36px;
        cursor: pointer;
        box-shadow: var(--shadow);
      }
      .detail-tabs {
        display: flex;
        gap: 0;
        border-bottom: 2px solid var(--secondary);
        margin: 18px 0 0 0;
      }
      .detail-tab {
        flex: 1;
        padding: 14px 0;
        background: none;
        border: none;
        font-size: 1em;
        color: var(--primary);
        cursor: pointer;
        font-weight: 500;
        border-bottom: 2.5px solid transparent;
        transition: background 0.12s, border 0.16s;
      }
      .detail-tab.active,
      .detail-tab:focus {
        background: var(--secondary);
        color: var(--accent);
        border-bottom: 2.5px solid var(--accent);
      }
      .detail-body {
        padding: 20px 22px 9px 22px;
      }
      .detail-body ul,
      .detail-body ol {
        padding-left: 22px;
        margin: 7px 0;
      }
      .detail-comments {
        margin: 6px 0;
      }
      .comment {
        margin-bottom: 18px;
        border-bottom: 1.5px solid var(--secondary);
        padding-bottom: 10px;
      }
      .comment-user {
        font-weight: 600;
        color: var(--primary);
        font-size: 1em;
      }
      .comment-rating {
        color: var(--accent);
        font-size: 0.9em;
        margin-left: 5px;
      }

      /* Bottom Nav */
      .bottom-nav {
        position: fixed;
        left: 0;
        right: 0;
        bottom: 0;
        background: #fff;
        border-top: 2px solid var(--secondary);
        display: flex;
        justify-content: space-around;
        align-items: center;
        height: 64px;
        box-shadow: 0 -2px 12px rgba(170,70,30,0.07);
        z-index: 40;
        font-size: 1.38em;
        max-width: 470px;
        margin: auto;
      }
      .nav-btn {
        flex: 1;
        text-align: center;
        border: none;
        background: none;
        color: #777;
        cursor: pointer;
        transition: color 0.17s;
        padding: 10px 0;
        font-size: 1.05em;
      }
      .nav-btn.active, .nav-btn:focus {
        color: var(--primary);
        font-weight: 600;
      }

      @media (max-width: 600px) {
        .container {
          border-radius: 0;
          min-height: 100dvh;
        }
        .bottom-nav {
          max-width: 100vw;
        }
      }
    </style>
  </head>
  <body>
    <div class="container">
      <!-- Search Bar -->
      <div class="search-bar">
        <input
          id="search"
          type="search"
          placeholder="Search recipes, e.g. pasta or chicken..."
          value={searchValue}
          onInput={e => { searchValue = e.target.value; }}
        />
        <button title="Search" aria-label="Search">
          🔍
        </button>
      </div>
      <!-- Featured Carousel -->
      <div class="carousel" tabindex="0">
        {featuredRecipes.map(r =>
          <div class="carousel-card" key={r.id} tabIndex="0" onClick={() => selectRecipe(r.id)}>
            <img src={r.image} alt={r.title + ' featured recipe'} />
            <h3>{r.title}</h3>
          </div>
        )}
      </div>
      <!-- Categories -->
      <div class="categories">
        {categories.map(cat => 
          <div
            class={
              "category-card" +
              (searchValue === cat.name ? ' active' : '')
            }
            tabIndex="0"
            key={cat.name}
            style={"border-color:" + cat.color}
            onClick={() => { searchValue = cat.name; }}
          >
            <div class="category-icon" style={"color:" + cat.color}>
              {cat.icon}
            </div>
            <div class="category-name">{cat.name}</div>
          </div>
        )}
      </div>
      <!-- Recipes List -->
      <div class="recipes-section">
        <div class="recipes-list">
          {getDisplayedRecipes().length === 0
            ? <div style="padding: 38px 0; text-align:center; color:#bbb">No recipes found.</div>
            : getDisplayedRecipes().map(r =>
              <div class="recipe-card" key={r.id} tabIndex="0" onClick={() => selectRecipe(r.id)}>
                <img class="recipe-img" src={r.img} alt={r.title + ' image'} />
                <div class="recipe-info">
                  <span class="recipe-title">{r.title}</span>
                  <span class="recipe-meta">
                    <span>★ {r.rating}</span>
                    <span>⏱ {r.cookTime}</span>
                    <span>{r.category}</span>
                  </span>
                </div>
                <button
                  class={"favorite-btn" + (favorites.includes(r.id) ? ' faved' : '')}
                  title={favorites.includes(r.id) ? "Remove from favorites" : "Add to favorites"}
                  aria-label="Favorite"
                  onClick={e => {
                    e.stopPropagation();
                    handleFavorite(r.id);
                  }}>
                  {favorites.includes(r.id) ? "♥" : "♡"}
                </button>
              </div>
            )
          }
        </div>
      </div>
      {/* Detailed Recipe Modal */}
      {selectedRecipe && (
        <div class="detail-modal" onClick={() => { selectedRecipe = null; }}>
          <div class="detail-content" onClick={e => { e.stopPropagation(); }}>
            <button class="close-btn" title="Close" onClick={() => { selectedRecipe = null; }}>
              &times;
            </button>
            <div class="detail-header">
              <img src={recipeDetails[selectedRecipe]?.img ?? ""} alt={recipeDetails[selectedRecipe]?.title + ' image'} />
              <div>
                <h2>{recipeDetails[selectedRecipe]?.title}</h2>
                <p>{recipeDetails[selectedRecipe]?.description}</p>
                <div class="detail-buttons">
                  <button onClick={() => handleFavorite(selectedRecipe)}>
                    {favorites.includes(selectedRecipe) ? "Favorited" : "Favorite"}
                  </button>
                  <button onClick={() => addToCollection(collections[0], selectedRecipe)}>
                    Add to Collection
                  </button>
                  <button onClick={() => window.open(window.location.href, '_blank')}>
                    Share
                  </button>
                </div>
              </div>
            </div>
            {/* Tabs */}
            <div class="detail-tabs">
              {["Ingredients", "Instructions", "Comments"].map(tab => 
                <button
                  key={tab}
                  class={"detail-tab" + (detailTab === tab ? ' active' : '')}
                  onClick={() => handleDetailTab(tab)}
                >{tab}</button>
              )}
            </div>
            <div class="detail-body">
              {detailTab === "Ingredients" && (
                <ul>
                  {(recipeDetails[selectedRecipe]?.ingredients ?? []).map((itm, i) => <li key={i}>{itm}</li>)}
                </ul>
              )}
              {detailTab === "Instructions" && (
                <ol>
                  {(recipeDetails[selectedRecipe]?.instructions ?? []).map((step, i) => <li key={i}>{step}</li>)}
                </ol>
              )}
              {detailTab === "Comments" && (
                <div class="detail-comments">
                  {(recipeDetails[selectedRecipe]?.comments ?? []).map((com, i) => 
                    <div class="comment" key={i}>
                      <span class="comment-user">{com.user}</span>
                      <span class="comment-rating">★ {com.rating}</span>
                      <div>{com.comment}</div>
                    </div>
                  )}
                  <form>
                    <label style="display:block;margin-top:18px;font-weight:500">Leave a Comment:</label>
                    <textarea rows="2" style="width:100%;padding:8px 10px;border-radius:8px;border:1.5px solid var(--secondary);margin-top:4px"></textarea>
                    <button type="submit" style="margin-top:9px;background:var(--accent);color:#fff;border:none;padding:7px 13px;border-radius:11px;cursor:pointer">
                      Submit
                    </button>
                  </form>
                </div>
              )}
            </div>
          </div>
        </div>
      )}

      <!-- Bottom Navigation Bar -->
      <nav class="bottom-nav" aria-label="Main navigation">
        <button class={"nav-btn" + (currentTab==="home"?" active":"")} onClick={() => handleTab("home")} aria-label="Home">
          <span>🏠</span><div style="font-size:0.78em">Home</div>
        </button>
        <button class={"nav-btn" + (currentTab==="favorites"?" active":"")} onClick={() => handleTab("favorites")} aria-label="Favorites">
          <span>♥</span><div style="font-size:0.78em">Favorites</div>
        </button>
        <button class={"nav-btn" + (currentTab==="collections"?" active":"")} onClick={() => handleTab("collections")} aria-label="Collections">
          <span>📁</span><div style="font-size:0.78em">Collections</div>
        </button>
        <button class={"nav-btn" + (currentTab==="profile"?" active":"")} onClick={() => handleTab("profile")} aria-label="Profile">
          <span>👤</span><div style="font-size:0.78em">Profile</div>
        </button>
      </nav>
    </div>
  </body>
</html>
